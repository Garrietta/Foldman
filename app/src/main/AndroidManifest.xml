<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- allowBackup / dataExtractionRules: nothing is backed up or copied to a new phone. -->
    <application
        android:allowNativeHeapPointerTagging="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:roundIcon,android:theme"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Foldman">

        <!-- Folding and unfolding resizes the window in place so the reels never stop mid-spin. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity-alias android:name="com.ivor.ivormusic.MainActivityDefault" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivityCrimson" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivityMidnight" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivityEmerald" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivitySunset" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivityOcean" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivityBlossom" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivityMonochrome" tools:node="remove" />
        <activity-alias android:name="com.ivor.ivormusic.MainActivitySolar" tools:node="remove" />

        <!-- Foldman embeds Koda's playback engine and data layer only. None of Koda's
             user-visible surfaces may come along: no Koda widgets in the picker, no Koda
             activity (its share-sheet and YouTube-link filters would open Koda's full UI),
             no Koda quick-settings tile. -->
        <activity android:name="com.ivor.ivormusic.MainActivity" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.PulseWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.ConsoleWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.DeckWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.LineupWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.BloomWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.VinylWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.PixelWidgetReceiver" tools:node="remove" />
        <receiver android:name="com.ivor.ivormusic.widget.OrbitWidgetReceiver" tools:node="remove" />
        <service android:name="com.ivor.ivormusic.service.PlaybackTileService" tools:node="remove" />

        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Foldman's own home-screen widget: a Material 3 Expressive horizontal Walkman. -->
        <receiver
            android:name=".ui.widget.FoldmanWidgetReceiver"
            android:exported="false"
            android:label="@string/foldman_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/foldman_widget_info" />
        </receiver>
    </application>
</manifest>
