<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of Foldman's leaves the phone: not in cloud backups, and not when moving to a new phone.
     Its settings hold the Apple Music user token, which shouldn't be copied anywhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
